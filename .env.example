# Copy this file to .env.local and fill in the values. Never commit .env.local.

# AWS: Polly (voice and mouth timing) and Transcribe (speech to text)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Only for temporary credentials
AWS_SESSION_TOKEN=

# Language model for the written feedback and the coach. Grok is used when its
# key is set; otherwise Claude.
GROK_API_KEY=
# Optional: another Grok model. The default answers in about 2 seconds; the larger ones took 15 to 30.
# GROK_MODEL=grok-4.20-0309-non-reasoning
ANTHROPIC_API_KEY=

# Supermemory: learner memory across sessions
SUPERMEMORY_API_KEY=

# Optional: Gemini behaviour notes from the recording
GEMINI_API_KEY=
